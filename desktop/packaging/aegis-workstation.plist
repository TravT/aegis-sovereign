<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aegis.sovereign.workstation</string>
    <key>WorkingDirectory</key>
    <string>@APP_ROOT@</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON_BIN@</string>
        <string>-m</string>
        <string>desktop.daemon.daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>@APP_ROOT@</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/aegis-workstation.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aegis-workstation.err</string>
</dict>
</plist>
