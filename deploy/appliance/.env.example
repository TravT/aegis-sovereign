# Aegis Sovereign Knowledge Appliance — Environment Configuration Template
# Copy to .env and set secure random values.
# NEVER commit plaintext passwords or production keys to version control.

# Server Bindings
SOVEREIGN_HOST=0.0.0.0
SOVEREIGN_PORT=8765
SOVEREIGN_APPLIANCE_URL=http://127.0.0.1:8765

# Data Storage Paths
SOVEREIGN_DATA_DIR=./data
SOVEREIGN_CONSUME_DIR=./data/consume
SOVEREIGN_GRAPH_DB_PATH=./data/rag/graph_store.db
SOVEREIGN_STATE_FILE=./data/rag/indexer_state.json

# Qdrant Vector Target (HTTP URL or local directory path for embedded serverless mode)
QDRANT_URL=http://aegis-qdrant:6333
SOVEREIGN_COLLECTION=sovereign_chunks
SOVEREIGN_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SOVEREIGN_SPARSE_MODEL=Qdrant/bm25

# Ghost Ingestion Database & Broker Credentials
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=generate_secure_random_postgres_password_here
PAPERLESS_SECRET_KEY=generate_secure_random_secret_key_here

# Notification Webhooks (Optional)
SOVEREIGN_ALERT_WEBHOOK_URL=
SOVEREIGN_TELEGRAM_BOT_TOKEN=
SOVEREIGN_TELEGRAM_CHAT_ID=
